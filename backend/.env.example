PORT=5000
MONGODB_URI=mongodb://localhost:27017/nexabank
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email delivery (Resend HTTP API)
# Create a key at https://resend.com/api-keys and verify the sender domain in Resend.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM_NAME=Blue ridge Bank
EMAIL_FROM_EMAIL=support@your-verified-domain.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
